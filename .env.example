APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# CRITICAL: Set APP_DEBUG=false in production to prevent stack trace
# leakage in API error responses.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SECURITY: Enable session encryption in production to prevent
# session data from being read if the storage is compromised.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SECURITY: Set to true in production for HTTPS-only session cookies
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# === WIS-CMS specific ===
# Church branch identity (used by seeders when creating the branch row).
# Safe to leave at defaults for the WIS pro-bono deploy.
CHURCH_NAME="Wesleyan International Society"
CHURCH_LOCATION="Kumasi, Ghana"

# Super admin credentials — REQUIRED for production deployment.
# In development the seeder falls back to admin@wis-cms.local / Admin@12345.
# In production these MUST be set in .env (the seeder fails safe if blank).
# Use a strong unique password. The admin should change it on first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Birthday greeting automation — master switch, channel, and template.
# The message supports {first_name} and {church} placeholders.
# Set BIRTHDAY_GREETINGS_ENABLED=false to disable all birthday SMS.
BIRTHDAY_GREETINGS_ENABLED=true
BIRTHDAY_GREETINGS_CHANNEL=sms
BIRTHDAY_GREETINGS_MESSAGE="Happy birthday, {first_name}! The {church} family celebrates with you today and prays God's richest blessings over your new year."

# mNotify SMS provider - REQUIRED for production SMS delivery.
# Get an API key at https://mnotify.com. The sender ID must be
# REGISTERED AND APPROVED by mNotify before it will deliver.
# In dev, MAIL=log captures what would have been sent so you don't
# need a real key locally.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=
MNOTIFY_BASE_URL=https://api.mnotify.com/api

