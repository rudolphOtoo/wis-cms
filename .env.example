# ═══════════════════════════════════════════════════════════
#  WIS-CMS — Environment Configuration
#  Copy this file to .env and adjust for your environment.
#
#  Docker deploy:  docker compose -f docker-compose.deploy.yml up -d
#  Local dev:      php artisan serve
# ═══════════════════════════════════════════════════════════

APP_NAME="Wesleyan International Society"
APP_ENV=production          # Use 'local' for development, 'production' for deploy
APP_KEY=                    # Generate with: php artisan key:generate
APP_DEBUG=false             # Set true for dev stack traces; false in production
APP_URL=http://localhost    # Your production URL (e.g. https://wis.example.com)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug              # Use 'warning' or 'error' in production

# ── Database ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1            # Docker deploy: set to 'postgres' (overridden in compose)
DB_PORT=5432                 # Docker deploy: host mapping is 5433:5432
DB_DATABASE=wis_cms
DB_USERNAME=wis_admin
DB_PASSWORD=wis_secret_2024

# ── Session ──────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false        # Enable in production if storing sensitive data
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false  # Set true in production for HTTPS-only cookies

# ── Queue / Cache / Broadcast ──────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Mail ─────────────────────────────────────────────────
MAIL_MAILER=log               # Switch to 'smtp' for real delivery
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Redis (optional) ─────────────────────────────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── AWS (optional) ───────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════
#  WIS-CMS specific settings
# ═══════════════════════════════════════════════════════════

# ── Church identity ──────────────────────────────────────
CHURCH_NAME="Wesleyan International Society"
CHURCH_LOCATION="Kumasi, Ghana"

# ── Super admin credentials ──────────────────────────────
# REQUIRED in production. Leave blank for dev fallback (admin@wis-cms.local / Admin@12345).
ADMIN_EMAIL=admin@wis-ayeduase.org
ADMIN_PASSWORD=your-strong-admin-password-here

# ── Birthday greeting automation ─────────────────────────
# Set to false to disable birthday SMS entirely.
# Message supports {first_name} and {church} placeholders.
BIRTHDAY_GREETINGS_ENABLED=true
BIRTHDAY_GREETINGS_CHANNEL=sms
BIRTHDAY_GREETINGS_MESSAGE="Happy birthday, {first_name}! The {church} family celebrates with you today and prays God's richest blessings over your new year."

# ── mNotify SMS provider ─────────────────────────────────
# REQUIRED for production SMS. Get API key at https://mnotify.com.
# The sender ID must be registered and approved by mNotify.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=
MNOTIFY_BASE_URL=https://api.mnotify.com/api

