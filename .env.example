# ═══════════════════════════════════════════════════════════════════════════════
#  WIS-CMS — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Usage:
#    cp .env.example .env
#    php artisan key:generate
#
#  Set every value below. Stubs marked `# REQUIRED` will crash the app if left
#  empty in production. Values marked `(dev default)` are safe for local dev.
#
#  Docker deploy (local or server):
#    cp .env.example .env
#    php artisan key:generate          # generates APP_KEY
#    # Fill in REQUIRED values below (DB_PASSWORD, ADMIN_PASSWORD, API keys)
#    docker compose -f docker-compose.deploy.yml up -d
#    # App available at http://localhost:8000
#    # Default admin: admin@wis-cms.local / Admin@12345
#
# ───────────────────────────────────────────────────────────────────────────────
#  APPLICATION
# ───────────────────────────────────────────────────────────────────────────────

APP_NAME="Wesleyan International Society"

# Active diocese profile — selects config/profiles/{slug}.php at deploy time.
# Built-in profiles: 'wis' (default, per-member register attendance) and
# 'mcgh' (Methodist Church Ghana, church-wide headcount tally).
#
# Single-step selection: pick ONE profile for the whole install and leave it
# set before first boot. Migrations, profile seeders, branding, attendance
# mode, and member numbering all follow from this one variable —
# docker/entrypoint.sh reads it on startup. Uncomment exactly one line:
#   DIOCESE_PROFILE=wis     # default — WIS install
#   DIOCESE_PROFILE=mcgh    # Methodist diocese install

# Environment: 'production' | 'local' | 'testing' | 'staging'
APP_ENV=production

# 32-byte base64 key — generate with: php artisan key:generate
# REQUIRED. If this changes post-deploy, all sessions, encrypted data, and
# password reset tokens become invalid immediately (irreversible data loss).
APP_KEY=                                  # REQUIRED — generate with: php artisan key:generate

# Comma-separated old APP_KEY values (for key rotation). Existing sessions
# and encrypted data will be decrypted with these keys before re-encrypting
# with the new APP_KEY. Remove old values after rotation completes.
# APP_PREVIOUS_KEYS=

# NEVER true in production — leaks env vars, credentials, and stack traces to users
APP_DEBUG=false

# Canonical URL, no trailing slash. Used for URL generation, asset() fallback, and mail links.
APP_URL=https://wis.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode backend: 'file' or 'cache'
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Number of hashing rounds (higher = slower but more secure). 12 is current best practice.
BCRYPT_ROUNDS=12

# Default number of records per page for paginated API endpoints
PAGINATION_PER_PAGE=15

# ───────────────────────────────────────────────────────────────────────────────
#  LOGGING
# ───────────────────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack               # 'stack' | 'single' | 'daily' | 'syslog' | 'papertrail' | 'slack'
LOG_STACK=single                # Stack channels (comma-separated)
LOG_LEVEL=warning               # 'debug'(dev) | 'info' | 'notice' | 'warning' | 'error' | 'critical'
LOG_DAILY_DAYS=30               # Retention when using 'daily' channel
LOG_DEPRECATIONS_CHANNEL=null   # 'null' silences deprecation notices; set to 'daily' to track them
LOG_DEPRECATIONS_TRACE=false

# Papertrail (optional — centralized cloud logging)
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# Slack error notifications (optional)
# LOG_SLACK_WEBHOOK_URL=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=#ops-alerts

# ───────────────────────────────────────────────────────────────────────────────
#  DATABASE  (PostgreSQL)
# ───────────────────────────────────────────────────────────────────────────────

DB_CONNECTION=pgsql

# Use DB_URL (single connection string) OR the individual fields below, not both.
# DB_URL=postgresql://user:password@host:5432/database?sslmode=require

DB_HOST=127.0.0.1               # Docker: set to service name 'postgres'
DB_PORT=5432                    # Docker: host mapping is typically 5433:5432
DB_DATABASE=wis_cms
DB_USERNAME=wis_admin
DB_PASSWORD=                            # REQUIRED — strong random password (min 24 chars)

# PostgreSQL SSL — set to 'require' for production, 'prefer' for dev, 'disable' only for local
DB_SSLMODE=prefer

# ───────────────────────────────────────────────────────────────────────────────
#  SESSION  (database-backed; member PII is stored here)
# ───────────────────────────────────────────────────────────────────────────────

SESSION_DRIVER=database         # 'database' | 'file' | 'redis' | 'cookie'
SESSION_LIFETIME=120            # Idle timeout in minutes
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true            # TRUE — member PII encrypted at rest via APP_KEY (must be set)
SESSION_CONNECTION=             # Leave empty to use the default DB connection
SESSION_TABLE=sessions
SESSION_STORE=                  # Cache store when SESSION_DRIVER='cache'
SESSION_PATH=/
SESSION_DOMAIN=null             # Set to '.example.com' for shared sessions across subdomains
SESSION_SECURE_COOKIE=false             # FALSE for local HTTP; TRUE only behind HTTPS
SESSION_HTTP_ONLY=true          # Prevent JavaScript access (XSS mitigation)
SESSION_SAME_SITE=lax           # 'lax' | 'strict' | 'none' (requires secure cookie)
SESSION_PARTITIONED_COOKIE=false # Top-level-site partitioning (CHIPS); requires secure + SameSite=none

# Cookie name — override only if multiple apps share the same domain
# SESSION_COOKIE=wis-cms-session

# ───────────────────────────────────────────────────────────────────────────────
#  CACHE
# ───────────────────────────────────────────────────────────────────────────────

# Production options (in order of preference): 'redis' | 'database' | 'file'
CACHE_STORE=database

# DB cache table (only used when CACHE_STORE=database)
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache

# Prefix to avoid collisions when multiple apps share the same cache backend
# CACHE_PREFIX=wis_cms_cache

# ───────────────────────────────────────────────────────────────────────────────
#  QUEUE  (background job processing)
# ───────────────────────────────────────────────────────────────────────────────

# Production: 'database' or 'redis'. NEVER 'sync' in production — jobs will be lost.
# A worker process must be running: php artisan queue:work --queue=default
QUEUE_CONNECTION=database

DB_QUEUE_CONNECTION=            # Leave empty to use the default DB connection
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90         # Seconds before a failed job is retried

# Failed jobs storage
# QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log        # 'log' | 'pusher' | 'ably' | 'redis'

# ───────────────────────────────────────────────────────────────────────────────
#  FILESYSTEM
# ───────────────────────────────────────────────────────────────────────────────

# 'local' for single-server dev; 's3' (or 'r2') for multi-server / Docker production
FILESYSTEM_DISK=local

# ───────────────────────────────────────────────────────────────────────────────
#  REDIS  (recommended for production — cache, queue, session, rate limiting)
# ───────────────────────────────────────────────────────────────────────────────

# Uncomment and configure for Redis-backed performance.
# REDIS_CLIENT=phpredis                  # 'phpredis' | 'predis' | 'mock'
# REDIS_URL=                             # Single connection string (overrides host/port/password below)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0                             # Default database number
# REDIS_CACHE_DB=1                       # Separate database for cache
# REDIS_PREFIX=wis_cms_database-
# REDIS_PERSISTENT=false
# REDIS_CACHE_CONNECTION=cache
# REDIS_QUEUE_CONNECTION=default

# ───────────────────────────────────────────────────────────────────────────────
#  CLOUD STORAGE  (AWS S3 / compatible)
# ───────────────────────────────────────────────────────────────────────────────

# Uncomment when FILESYSTEM_DISK=s3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ───────────────────────────────────────────────────────────────────────────────
#  MAIL
# ───────────────────────────────────────────────────────────────────────────────

# Switch to 'smtp' for production delivery; 'ses' for AWS SES; 'log' for dev
MAIL_MAILER=smtp
MAIL_SCHEME=                    # 'smtps' for implicit TLS; null for STARTTLS
MAIL_HOST=smtp.example.com
MAIL_PORT=587                   # 587 (STARTTLS) | 465 (implicit TLS/SSL) | 25 (plain, usually blocked)
MAIL_USERNAME=                  # SMTP username
MAIL_PASSWORD=                  # SMTP password
MAIL_ENCRYPTION=tls             # 'tls' | 'ssl' | null
MAIL_FROM_ADDRESS="noreply@wis.example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL=                      # DSN format alternative (smtp://user:pass@host:port)

# Optional third-party mail drivers
# POSTMARK_API_KEY=
# RESEND_API_KEY=

# ───────────────────────────────────────────────────────────────────────────────
#  SANCTUM  (SPA authentication & API tokens)
# ───────────────────────────────────────────────────────────────────────────────

# Comma-separated frontend domains allowed to authenticate via session cookies.
# REQUIRED in production — without this, SPA login silently fails with 401.
# Example: SANCTUM_STATEFUL_DOMAINS=wis.example.com,admin.wis.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,localhost:8001

# API token lifetime in minutes (10080 = 7 days)
SANCTUM_EXPIRATION=10080

# Optional prefix added to all issued tokens (aids secret scanning compliance)
# SANCTUM_TOKEN_PREFIX=

# ───────────────────────────────────────────────────────────────────────────────
#  CORS
# ───────────────────────────────────────────────────────────────────────────────

# Exact origin(s) of your SPA frontend. Comma-separated for multiple origins.
# NEVER use '*' in production with credentials (breaks CORS entirely).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ───────────────────────────────────────────────────────────────────────────────
#  TRUSTED PROXIES  (required behind Nginx / Cloudflare / AWS ALB)
# ───────────────────────────────────────────────────────────────────────────────

# Set to '*' to trust all proxies, or a comma-separated list of proxy IPs/subnets.
# Without this: HTTPS redirects loop, URL generation uses http://, rate limiting sees proxy IP.
# Also add to bootstrap/app.php: $middleware->trustProxies(at: '*')
TRUSTED_PROXIES=*

# ───────────────────────────────────────────────────────────────────────────────
#  VITE  (frontend asset bundling)
# ───────────────────────────────────────────────────────────────────────────────

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# ═══════════════════════════════════════════════════════════════════════════════
#  WIS-CMS APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# ── Church identity ───────────────────────────────────────────────────────────

CHURCH_NAME="Wesleyan International Society"
CHURCH_LOCATION="Kumasi, Ghana"

# ── Super admin (seeded on first deploy) ──────────────────────────────────────

# REQUIRED in production. Leave blank for dev fallback:
#   admin@wis-cms.local / Admin@12345
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-admin-password-here

# ── Activity log (audit trail) ────────────────────────────────────────────────

ACTIVITYLOG_ENABLED=true
# ACTIVITYLOG_BUFFER_ENABLED=false

# ── Birthday greeting automation ──────────────────────────────────────────────

# Set false to disable automated SMS. Message supports {first_name} and {church}.
BIRTHDAY_GREETINGS_ENABLED=true
BIRTHDAY_GREETINGS_CHANNEL=sms
BIRTHDAY_GREETINGS_MESSAGE="Happy birthday, {first_name}! The {church} family celebrates with you today and prays God's richest blessings over your new year."

# ── mNotify SMS provider ──────────────────────────────────────────────────────

# REQUIRED for production SMS. Get API key at https://mnotify.com.
# The sender ID must be registered and approved by mNotify.
#
# MNOTIFY_DRY_RUN controls whether SMS are really sent:
#   false = REAL sends + remote scheduling on mNotify's servers (production).
#   true / unset = dry-run: SMS are logged locally, never delivered.
# When set to false, SMS automation commands (sms:sync-rolling-automations,
# reminders:send, sync:pending-schedules) run even under APP_ENV=local so a
# church PC can offload reminders to mNotify and power down safely.
MNOTIFY_API_KEY=                # REQUIRED
MNOTIFY_SENDER_ID=              # REQUIRED — registered sender name (e.g. WIS-CMS)
MNOTIFY_DRY_RUN=false           # REQUIRED for live churches — see note above
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# ── Paystack (Mobile Money / Card payments) ───────────────────────────────────
#
# Sign up at https://dashboard.paystack.com, switch to live mode, and copy
# your keys. The webhook secret is generated in Settings > Developer > Webhooks.
PAYSTACK_SECRET_KEY=               # REQUIRED — server-side, never expose to frontend
PAYSTACK_PUBLIC_KEY=               # REQUIRED — safe for frontend inline checkout
PAYSTACK_WEBHOOK_SECRET=           # REQUIRED — HMAC secret for webhook verification

# ── Member intake webhook (Google Form integration) ───────────────────────────

# Shared secret for authenticating POST /api/webhooks/member-submission.
# Generate: php -r "echo bin2hex(random_bytes(24));"
# Treat like a database password — anyone with this secret can submit member data.
GOOGLE_FORM_WEBHOOK_SECRET=     # REQUIRED — 48-character hex string

# ── Password validation ─────────────────────────────────────────────────────
#
# When true, the HaveIBeenPwned data-leak check (Password::uncompromised())
# is enforced even in non-production environments. Defaults to false so
# developers can set common test passwords locally. Set to true in staging
# or production to require compromised-password screening.
# ENABLE_PWNED_PASSWORD_CHECK=false
